generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model CatRegimen {
  id          Int    @id @default(autoincrement()) @db.SmallInt
  raw         String @unique @db.VarChar(30)
  normalizado String @db.VarChar(20)

  @@map("cat_regimen")
}

model CatTipoAgenda {
  id          Int    @id @default(autoincrement()) @db.SmallInt
  raw         String @unique @db.VarChar(50)
  normalizado String @db.VarChar(20)

  @@map("cat_tipo_agenda")
}

model CatTipoCita {
  id          Int    @id @default(autoincrement()) @db.SmallInt
  raw         String @unique @db.VarChar(30)
  normalizado String @db.VarChar(20)

  @@map("cat_tipo_cita")
}

model CatEstadoCita {
  id                 Int    @id @default(autoincrement()) @db.SmallInt
  raw                String @unique @db.VarChar(30)
  estadoAutorizacion String @db.VarChar(30) @map("estado_autorizacion")
  estadoConsulta     String @db.VarChar(20) @map("estado_consulta")

  @@map("cat_estado_cita")
}

model CatSede {
  id          Int    @id @default(autoincrement()) @db.SmallInt
  raw         String @unique @db.VarChar(100)
  normalizado String @db.VarChar(100)

  @@map("cat_sede")
}

model CatConvenio {
  id                    Int     @id @default(autoincrement()) @db.SmallInt
  nombreConvenio        String  @unique @db.VarChar(200) @map("nombre_convenio")
  tipoServicio          String? @db.VarChar(20) @map("tipo_servicio")
  nombreMpio            String? @db.VarChar(50) @map("nombre_mpio")
  entidadAdministradora String? @db.VarChar(100) @map("entidad_administradora")
  regimen               String? @db.VarChar(20)

  @@map("cat_convenio")
}

model CatConvenioSap {
  id                    Int     @id @default(autoincrement()) @db.SmallInt
  sedeUo                String  @db.VarChar(100) @map("sede_uo")
  codAseguradora        String  @db.VarChar(30) @map("cod_aseguradora")
  interlocutorComercial String  @db.VarChar(100) @map("interlocutor_comercial")
  nombreConvenio        String? @db.VarChar(200) @map("nombre_convenio")
  tipoServicio          String? @db.VarChar(20) @map("tipo_servicio")
  regimen               String? @db.VarChar(20)
  nombreSede            String? @db.VarChar(100) @map("nombre_sede")
  nombreMpio            String? @db.VarChar(50) @map("nombre_mpio")
  entidadAdministradora String? @db.VarChar(100) @map("entidad_administradora")

  @@unique([sedeUo, codAseguradora, interlocutorComercial], name: "uk_sap")
  @@map("cat_convenio_sap")
}

model CatCups {
  id          Int     @id @default(autoincrement()) @db.SmallInt
  codigo      String  @unique @db.VarChar(10)
  descripcion String? @db.VarChar(200)
  homologado  String? @db.VarChar(100)
  pym         String? @db.VarChar(100)
  grupo       String? @db.VarChar(100)

  @@map("cat_cups")
}

model CatCupsPana {
  id               Int    @id @default(autoincrement()) @db.SmallInt
  especialidadCita String @db.VarChar(100) @map("especialidad_cita")
  esControl        String @db.Char(1) @map("es_control")
  codigo           String @db.VarChar(10)
  homologado       String @db.VarChar(100)

  @@unique([especialidadCita, esControl], name: "uk_pana")
  @@map("cat_cups_pana")
}

model CatEspecialidad {
  id                Int     @id @default(autoincrement()) @db.SmallInt
  raw               String  @unique @db.VarChar(100)
  espAjustada       String? @db.VarChar(100) @map("esp_ajustada")
  grupoEspecialidad String? @db.VarChar(100) @map("grupo_especialidad")

  @@map("cat_especialidad")
}

