# Prisma - URL para migraciones y CLI
DATABASE_URL="mysql://root@localhost:3306/citas_db"

# NestJS - Variables de conexión para el adapter MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=citas_db

# App
NODE_ENV=development
PORT=5808

# Auth (JWT — misma secret que la app principal)
JWT_SECRET=your-secret-here

# CORS (origen del frontend — separar por coma si son varios)
CORS_ORIGIN=http://localhost:5173