        <mxCell id="title" value="Nordvital IPS — Flujo de datos end-to-end:  Orígenes → ETL → costos / nt_map → API NestJS → 5 Dashboards" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1">
