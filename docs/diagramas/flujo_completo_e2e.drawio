        <mxCell id="src_sap" value="&lt;b&gt;SAP&lt;/b&gt;&lt;br&gt;Sistema administrativo&lt;br&gt;Excel Hoja1 · ~71.5k&lt;br&gt;clave: episodio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="45" y="470" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bots" value="&lt;b&gt;Bots de descarga&lt;/b&gt;&lt;br&gt;Citas_PLENUS.py (Playwright)&lt;br&gt;Citas_PANA.py (Playwright)&lt;br&gt;Citas_SAP.py (PyAutoGUI)&lt;br&gt;→ data/descarga_diaria/" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="45" y="650" width="180" height="120" as="geometry" />
