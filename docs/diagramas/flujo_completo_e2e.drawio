        <mxCell id="pg_fin" value="&lt;b&gt;Análisis Financiero&lt;/b&gt;&lt;br&gt;costo real vs NT · Pareto CUPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1585" y="222" width="220" height="48" as="geometry" />
        </mxCell>
        <mxCell id="pg_cal" value="&lt;b&gt;Calidad y Oportunidad&lt;/b&gt;&lt;br&gt;oportunidad · estados/sede · inasistencia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
