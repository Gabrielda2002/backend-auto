        <!-- ===================== FASE 1 · ORÍGENES ===================== -->
        <mxCell id="src_plenus" value="&lt;b&gt;PLENUS&lt;/b&gt;&lt;br&gt;Sistema clínico&lt;br&gt;CSV TAB · ~190k&lt;br&gt;clave: agendacita_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="45" y="130" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="src_pana" value="&lt;b&gt;PANA&lt;/b&gt;&lt;br&gt;Agenda secundaria&lt;br&gt;CSV «;» · ~119k&lt;br&gt;clave: codigo_cita" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="45" y="300" width="180" height="80" as="geometry" />
