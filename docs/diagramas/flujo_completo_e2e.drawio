        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;" edge="1" parent="1" source="csv_pana" target="raw_pana"><mxGeometry relative="1" as="geometry" /></mxCell>
