        <mxCell id="pg_ejec" value="&lt;b&gt;Ejecución vs Nota Técnica&lt;/b&gt;&lt;br&gt;heatmap convenio×CUPS · catálogo NT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
