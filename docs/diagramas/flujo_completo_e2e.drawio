        <!-- ===================== FASE 2 · STAGING ===================== -->
        <mxCell id="csv_plenus" value="&lt;b&gt;Raw_PLENUS.csv&lt;/b&gt;&lt;br&gt;separador TAB&lt;br&gt;append-only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="275" y="130" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="csv_pana" value="&lt;b&gt;Raw_PANA.csv&lt;/b&gt;&lt;br&gt;separador «;»&lt;br&gt;append-only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="275" y="300" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="csv_sap" value="&lt;b&gt;Raw_SAP.xlsx&lt;/b&gt;&lt;br&gt;Excel Hoja1&lt;br&gt;append-only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="275" y="470" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note_append" value="&lt;b&gt;01_carga_diaria_csv.py&lt;/b&gt;&lt;br&gt;Append incremental de las descargas a los maestros.&lt;br&gt;⚠ Sin deduplicación: rangos solapados pueden duplicar citas." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="275" y="650" width="180" height="120" as="geometry" />
        </mxCell>

        <!-- ===================== FASE 3 · RAW MySQL ===================== -->
        <mxCell id="raw_plenus" value="&lt;b&gt;raw_plenus&lt;/b&gt;&lt;br&gt;56 columnas" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;boundedLbl=1;backgroundOutline=1;" vertex="1" parent="1">
          <mxGeometry x="525" y="130" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="raw_pana" value="&lt;b&gt;raw_pana&lt;/b&gt;&lt;br&gt;46 columnas" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;boundedLbl=1;backgroundOutline=1;" vertex="1" parent="1">
          <mxGeometry x="525" y="300" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="raw_sap" value="&lt;b&gt;raw_sap&lt;/b&gt;&lt;br&gt;58 columnas" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;boundedLbl=1;backgroundOutline=1;" vertex="1" parent="1">
          <mxGeometry x="525" y="470" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note_load" value="&lt;b&gt;03_carga_diaria_DB.py&lt;/b&gt;&lt;br&gt;TRUNCATE + carga por chunks (2000).&lt;br&gt;Luego ejecuta 04_insert_costos.sql.&lt;br&gt;Modos: --solo-raw / --solo-costos" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="510" y="650" width="180" height="120" as="geometry" />
        </mxCell>

        <!-- ===================== FASE 4 · ETL TRANSFORM ===================== -->
        <mxCell id="bloque1" value="&lt;b&gt;BLOQUE 1 · PLENUS → costos&lt;/b&gt;&lt;br&gt;JOIN catálogos · CUPS homologado · tipo_cita" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="735" y="120" width="270" height="55" as="geometry" />
        </mxCell>
        <mxCell id="bloque2" value="&lt;b&gt;BLOQUE 2 · PANA → costos&lt;/b&gt;&lt;br&gt;Regla NORDVITAL IPS SAS → NUEVA EPS&lt;br&gt;CUPS por (especialidad_cita, control)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="735" y="180" width="270" height="62" as="geometry" />
        </mxCell>
        <mxCell id="bloque3" value="&lt;b&gt;BLOQUE 3 · SAP → costos&lt;/b&gt;&lt;br&gt;Clave compuesta (sede_uo, cod_aseg, interloc.)&lt;br&gt;prestación pos 9-16 = CUPS · 9-12 = tipo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="735" y="247" width="270" height="62" as="geometry" />
        </mxCell>
        <mxCell id="bloque4" value="&lt;b&gt;BLOQUE 4 · UPDATE grupo_especialidad&lt;/b&gt;&lt;br&gt;CASE por LIKE → 7 grupos (+OTROS)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="735" y="314" width="270" height="48" as="geometry" />
        </mxCell>
        <mxCell id="bloque5" value="&lt;b&gt;BLOQUE 5 · UPDATE nombre_sede&lt;/b&gt;&lt;br&gt;Cúcuta: Calle 8→Sede 07 · CL 14→Sede 06&lt;br&gt;Calle 15→Sede 04 · Sede 3/3E→Sede 03" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="735" y="367" width="270" height="62" as="geometry" />
        </mxCell>
        <mxCell id="catalogos" value="&lt;b&gt;Catálogos cat_* (normalización)&lt;/b&gt;&lt;br&gt;cat_estado_cita · cat_sede · cat_regimen&lt;br&gt;cat_convenio · cat_convenio_sap&lt;br&gt;cat_cups · cat_cups_pana · cat_especialidad&lt;br&gt;cat_convenio_agrupador (convenio/sede/modalidad/régimen)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;align=left;spacingLeft=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="735" y="455" width="270" height="120" as="geometry" />
        </mxCell>
        <mxCell id="note_estado" value="&lt;b&gt;Regla de estado (cat_estado_cita)&lt;/b&gt;&lt;br&gt;REAL · PLAN · AUTORIZADO · ACTIVO → CUMPLIDA&lt;br&gt;INCUMPLIDO · # · NO CONFIRMADA → INCUMPLIDA&lt;br&gt;CITA CANCELADA → CANCELADA" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="735" y="650" width="270" height="120" as="geometry" />
        </mxCell>

        <!-- ===================== FASE 5 · MODELO ===================== -->
        <mxCell id="costos" value="&lt;b&gt;costos&lt;/b&gt; (tabla maestra)&lt;br&gt;~381k filas · 40 columnas&lt;br&gt;&lt;br&gt;fuente · fecha_cita · estado_consulta&lt;br&gt;cups · nombre_convenio · nombre_sede&lt;br&gt;especialidad · grupo_especialidad&lt;br&gt;&lt;br&gt;&lt;i&gt;agrupadores:&lt;/i&gt; convenio_grupo · sede_grupo&lt;br&gt;modalidad · regimen_grupo" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;boundedLbl=1;backgroundOutline=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1055" y="120" width="210" height="200" as="geometry" />
        </mxCell>
        <mxCell id="notas_tecnicas" value="&lt;b&gt;notas_tecnicas&lt;/b&gt;&lt;br&gt;Metas por CUPS y convenio&lt;br&gt;n_eventos_mes · costo_medio_evento" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;boundedLbl=1;backgroundOutline=1;" vertex="1" parent="1">
          <mxGeometry x="1055" y="400" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="nt_map" value="&lt;b&gt;nt_map&lt;/b&gt; (tabla puente)&lt;br&gt;clave (cups, nombre_convenio)&lt;br&gt;meta_mes · costo_medio&lt;br&gt;duplica filas «/ SUBSIDIADO»&lt;br&gt;→ CONTRIBUTIVO + SUBSIDIADO" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;boundedLbl=1;backgroundOutline=1;" vertex="1" parent="1">
          <mxGeometry x="1055" y="540" width="210" height="110" as="geometry" />
        </mxCell>

        <!-- ===================== FASE 6 · API ===================== -->
        <mxCell id="ep_resumen" value="GET /dashboards/&lt;b&gt;resumen&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1315" y="115" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ep_ejec" value="GET /dashboards/&lt;b&gt;ejecucion-nt&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1315" y="168" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ep_fin" value="GET /dashboards/&lt;b&gt;financiero&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1315" y="221" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ep_cal" value="GET /dashboards/&lt;b&gt;calidad&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1315" y="274" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ep_pym" value="GET /dashboards/&lt;b&gt;pym&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1315" y="327" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ep_filtros" value="GET /filtros/* (facetados)&lt;br&gt;sedes-jerarquia · convenios-grupo&lt;br&gt;modalidades · regimenes · grupos-especialidad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1315" y="385" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="note_api" value="&lt;b&gt;Cálculos clave (dashboards.service.ts)&lt;/b&gt;&lt;br&gt;• buildCostosWhere → WHERE parametrizado&lt;br&gt;• cumplimiento = CUMPLIDA / con_estado&lt;br&gt;• ejecución = citas / (meta_mes × meses)&lt;br&gt;• costo = Σ nt_map.costo_medio (JOIN cups+conv)&lt;br&gt;• &lt;b&gt;solo-NT&lt;/b&gt;: excluye eventos sin meta (nivel cita)&lt;br&gt;• ⚠ meses = 5 (Ene-May 2026) en varias queries" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1315" y="470" width="220" height="150" as="geometry" />
        </mxCell>

        <!-- ===================== FASE 7 · FRONTEND ===================== -->
        <mxCell id="pg_resumen" value="&lt;b&gt;Resumen de Citas&lt;/b&gt;&lt;br&gt;3 KPIs · evolución · cumplimiento" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1585" y="110" width="220" height="48" as="geometry" />
