        <mxCell id="band7" value="7 · FRONTEND  (Vite + React)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ecf7ea;strokeColor=#aed5a3;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#3d7a2e;opacity=70;" vertex="1" parent="1">
          <mxGeometry x="1570" y="70" width="250" height="820" as="geometry" />
